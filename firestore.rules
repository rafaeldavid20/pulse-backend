rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Platform Actions collection audit log
    match /platform_actions/{actionId} {
      allow read, write: if isAuthenticated();
    }
    
    // User profile documents
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isUser(userId);
    }
    
    // Workspace documents
    match /workspaces/{workspaceId} {
      allow read, write: if isAuthenticated();
    }
    
    // Workspace members collection
    match /members/{memberId} {
      allow read, write: if isAuthenticated();
    }

    // Team collection
    match /teams/{teamId} {
      allow read, write: if isAuthenticated();
    }
    
    // Issues collection — write is Admin SDK only (via Platform Actions,
    // which is where `authorize()`/isWorkspaceMember actually runs). The
    // client-side fallback that used to write here directly was removed
    // from pulse-app/src/lib/firestore.ts in the same pass as this rule —
    // don't loosen this back to `if isAuthenticated()` without re-adding an
    // authorized write path first.
    match /issues/{issueId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Projects collection — same as issues, Admin SDK only.
    match /projects/{projectId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Labels collection — same as issues, Admin SDK only (via labels.create).
    match /labels/{labelId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    
    // Invitations collection
    match /invitations/{invitationId} {
      allow read, write: if isAuthenticated();
    }

    // Atomic issue-numbering counters (workspaceId_teamId -> value). Written
    // by the pulsePlatformAction Cloud Function only — the client-side
    // fallback that used to write here directly was removed, but the rule
    // itself is left open (not in scope for this hardening pass; it's an
    // internal counter, not a piece of domain data an attacker gains
    // anything from tampering with).
    match /counters/{counterId} {
      allow read, write: if isAuthenticated();
    }

    // API keys for MCP access: contain a secret hash. Only the Admin SDK
    // (Platform Actions apikeys.create/revoke/list, and the MCP request
    // authenticator) ever reads or writes this collection — never the
    // client, so there is no client-side fallback to preserve here.
    match /api_keys/{keyId} {
      allow read, write: if false;
    }

    // Comments on issues — Admin SDK only (comments.create always required
    // this in practice, since it authorizes against the issue's real
    // workspaceId; this just makes the rule match what was already true).
    match /comments/{commentId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Operational agent config (defaultRepo, autonomousMode, etc). Admin SDK
    // only via the agents.create Platform Action — no part of the app reads
    // it directly (the agent's *presence* in the UI comes from its `members`
    // doc, not this collection).
    match /agents/{agentId} {
      allow read, write: if false;
    }

    // GitHub App installations: holds a cached installation access token per
    // doc. Admin SDK only (githubSetup writes it, create-branch.ts reads
    // it) — the frontend gets a sanitized view via the github.status
    // Platform Action instead of reading this directly.
    match /github_installations/{installationId} {
      allow read, write: if false;
    }

    // Webhook delivery idempotency ledger (X-GitHub-Delivery -> processed).
    // Admin SDK only — githubWebhook is the only writer, nothing reads it.
    match /webhook_events/{deliveryId} {
      allow read, write: if false;
    }

    // Daily per-workspace counter for the Fase 6 autonomous-dispatch circuit
    // breaker. Admin SDK only — agentDispatchTrigger is the only writer.
    match /agent_dispatch_counters/{counterId} {
      allow read, write: if false;
    }
  }
}
