rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Platform Actions collection audit log
    match /platform_actions/{actionId} {
      allow read, write: if isAuthenticated();
    }
    
    // User profile documents
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isUser(userId);
    }
    
    // Workspace documents
    match /workspaces/{workspaceId} {
      allow read, write: if isAuthenticated();
    }
    
    // Workspace members collection
    match /members/{memberId} {
      allow read, write: if isAuthenticated();
    }

    // Team collection
    match /teams/{teamId} {
      allow read, write: if isAuthenticated();
    }
    
    // Issues collection
    match /issues/{issueId} {
      allow read, write: if isAuthenticated();
    }
    
    // Projects collection
    match /projects/{projectId} {
      allow read, write: if isAuthenticated();
    }
    
    // Labels collection
    match /labels/{labelId} {
      allow read, write: if isAuthenticated();
    }
    
    // Invitations collection
    match /invitations/{invitationId} {
      allow read, write: if isAuthenticated();
    }

    // Atomic issue-numbering counters (workspaceId_teamId -> value).
    // Written both by the pulsePlatformAction Cloud Function and, as a
    // fallback, directly from the client (see nextIssueNumber() in
    // pulse-app/src/lib/firestore.ts) — must stay writable client-side
    // until that fallback path is retired.
    match /counters/{counterId} {
      allow read, write: if isAuthenticated();
    }

    // API keys for MCP access: contain a secret hash. Only the Admin SDK
    // (Platform Actions apikeys.create/revoke/list, and the MCP request
    // authenticator) ever reads or writes this collection — never the
    // client, so there is no client-side fallback to preserve here.
    match /api_keys/{keyId} {
      allow read, write: if false;
    }

    // Comments on issues. Same openness as issues/projects for now — not
    // hardened until Fase 5. Mirrored in pulse-app/firestore.rules too:
    // whichever repo's workflow deploys rules last wins (see the plan's
    // "two firestore.rules" known issue), so a collection the client needs
    // open must be declared identically in both files, not just this one.
    match /comments/{commentId} {
      allow read, write: if isAuthenticated();
    }

    // Operational agent config (defaultRepo, autonomousMode, etc). Admin SDK
    // only via the agents.create Platform Action — no part of the app reads
    // it directly (the agent's *presence* in the UI comes from its `members`
    // doc, not this collection).
    match /agents/{agentId} {
      allow read, write: if false;
    }

    // GitHub App installations: holds a cached installation access token per
    // doc. Admin SDK only (githubSetup writes it, create-branch.ts reads
    // it) — the frontend gets a sanitized view via the github.status
    // Platform Action instead of reading this directly.
    match /github_installations/{installationId} {
      allow read, write: if false;
    }
  }
}
