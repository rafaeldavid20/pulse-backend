{
  "name": "functions",
  "version": "1.0.0",
  "description": "Cloud Functions for Pulse Platform Actions Engine",
  "main": "lib/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase serve --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "migrate:hierarchy": "node scripts/migrate-hierarchy.mjs"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/libsodium-wrappers": "^0.7.14",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "libsodium-wrappers": "^0.8.4",
    "nanoid": "^3.3.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  },
  "private": true
}
